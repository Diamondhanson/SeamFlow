NODE_ENV=development
PORT=3001

# Supabase — required
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres — required for Drizzle ORM
# Supabase dashboard → Settings → Database → Connection string → URI (Transaction, port 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Redis — optional. If empty, BullMQ queues are disabled and /health reports redis: "disabled".
# Upstash dashboard → Connect → standard rediss:// URL (port 6379 with TLS)
REDIS_URL=

# Sentry — optional. If empty, error tracking is disabled.
SENTRY_DSN=

# Anthropic (Claude) — optional. Powers AI "auto-describe" (image → text).
# If empty, POST /ai/describe-image returns 503 and the API still boots.
# Get a key + $5 free credit at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Share-link signing — required for Phase 1.5 magic links.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SHARE_LINK_JWT_SECRET=

# Base URL of seamflow-web for building share URLs in the API responses.
# Use your deployed web domain. Only set this to http://localhost:3000 when you
# are specifically testing the web app locally.
WEB_BASE_URL=https://www.seamflowtech.com

# ── Subscription emails (Resend) ──────────────────────────────────────────────
# Subscriptions are sold on the web, because neither app store allows selling
# in-app features through our own rails. That makes email the only channel that
# may tell a tailor what premium costs and where to buy it — and on iPhone, the
# only way they will ever find out. Leave blank and the reminder job logs
# instead of sending.
#
# 1. Create a key at https://resend.com/api-keys (starts with "re_")
# 2. Verify the DOMAIN seamflowtech.com in Resend and add the DNS records it
#    gives you, or mail lands in spam.
RESEND_API_KEY=
# The From address. Must be on a domain verified in Resend. Matches the one
# Supabase already sends account emails from, so tailors see one sender.
EMAIL_FROM=SeamFlow <contact@seamflowtech.com>
# Where replies go. seamflowtech.com has no inbox, so without this a tailor
# who replies to a renewal email is writing into nothing.
EMAIL_REPLY_TO=contactseamflow@gmail.com
# Where the plans live. Every subscription email links here.
APP_WEB_URL=https://app.seamflowtech.com

# ── Payments: Fapshi (MTN MoMo + Orange Money, Cameroon) ──────────────────────
# Sell subscriptions through Fapshi. Unset SUBSCRIPTION_PAYMENT_PROVIDER means
# no rail at all: checkout answers 503 and the app says "payment is coming
# soon". Set it to 'fapshi' once the credentials below are filled in.
SUBSCRIPTION_PAYMENT_PROVIDER=
# 'sandbox' (test money, https://sandbox.fapshi.com) or 'live' (real money).
# Credentials are PER ENVIRONMENT: a sandbox service and a live service each
# have their own apiuser/apikey on the Fapshi dashboard.
FAPSHI_ENV=sandbox
FAPSHI_API_USER=
FAPSHI_API_KEY=
# The webhook secret you set on the Fapshi dashboard for this service. Fapshi
# echoes it in the x-wh-secret header; without it every webhook is refused.
FAPSHI_WEBHOOK_SECRET=
