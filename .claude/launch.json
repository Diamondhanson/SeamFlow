{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "seamflow-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "dev",
        "--port",
        "3000"
      ],
      "cwd": "apps/seamflow-web",
      "port": 3000
    },
    {
      "name": "seamflow-web-prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "start",
        "--port",
        "3100"
      ],
      "cwd": "apps/seamflow-web",
      "port": 3100
    },
    {
      "name": "app-web-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "serve",
        "dist",
        "-l",
        "4300",
        "-s"
      ],
      "cwd": "apps/seamflow-app",
      "port": 4300
    },
    {
      "name": "client-web-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "serve",
        "dist",
        "-l",
        "4400",
        "-s"
      ],
      "cwd": "apps/seamflow-client",
      "port": 4400
    },
    {
      "name": "seamflow-admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "apps/seamflow-admin",
      "port": 3200
    },
    {
      "name": "tailor-web-dev",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8085"
      ],
      "cwd": "apps/seamflow-app",
      "port": 8085
    },
    {
      "name": "seamflow-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "apps/seamflow-api",
      "port": 3001
    }
  ]
}
